# Binance API
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_API_SECRET=tu_api_secret_aqui
BINANCE_TESTNET=false          # true para usar testnet de Binance (recomendado para pruebas)

# Telegram
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui   # obtenelo desde @BotFather
TELEGRAM_CHAT_ID=tu_chat_id_aqui       # tu ID de chat personal (podés obtenerlo con @userinfobot)

# Comportamiento del agente
CHECK_INTERVAL_MINUTES=60              # con qué frecuencia analiza el portafolio
STATE_FILE=state.json                  # archivo de estado persistente
